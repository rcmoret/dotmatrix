[alias]
	aliases = !git config -l | grep '^alias' | cut -c 7- | sort
	aa = add -A .
	add-untracked = !"git status --porcelain | awk '/\\?\\?/{ print $2 }' | xargs git add"
	b = branch
	br = branch
	cheddar = commit --amend -CHEAD
	ci = commit
	clone-all = clone --recurse-submodules
	co = checkout
	cp = cherry-pick
	doff = reset HEAD^
	find = !sh -c 'git ls-files | grep --color=always -i "$@" | less -FRSX' -
	fixup = commit --fixup
	pruneremote = remote prune origin
	pull-all = pull --recurse-submodules
	put = push origin HEAD
	recent = for-each-ref --sort=-committerdate --count=10 --format='%(refname:short)' refs/heads/
	reset-authors = commit --amend --reset-author -CHEAD
	ri = rebase --interactive
	rmbranch = "!f(){ git branch -d ${1} && git push origin --delete ${1}; };f"
	snapshot = !git stash save "snapshot: $(date)" && git stash apply "stash@{0}"
	squash = commit --squash
	st = status
	tr = log --graph --oneline --decorate --color
	tree = log --graph --oneline --decorate --color --all
	undo = reset HEAD^
[add]
	patch = true
[branch]
	autosetuprebase = always
[color]
	ui = true
[commit]
	verbose = true
[core]
	excludesfile = ~/.gitignore_global
	editor = nvim
	whitespace = cr-at-eol
	hooksPath = ~/.git/hooks
	pager = diff-so-fancy | less --tabs=4 -RF
[diff]
	algorithm = patience
[diff-so-fancy]
	markEmptyLines = false
	stripLeadingSymbols = false
	changeHunkIndicators = true
[fetch]
	prune = true
	pruneTags = true
[help]
	autocorrect = 10
[init]
	defaultBranch = main
[merge]
	summary = true
[push]
	autoSetupRemote = true
[rebase]
	autosquash = true
[submodule]
	recurse = true
; Local overrides and the light/dark color scheme. Both are untracked and
; optional -- git silently ignores an include whose file is missing.
; ~/.gitconfig.colors is a symlink managed by the `git-colors` shell function.
[include]
	path = ~/.gitconfig.local
	path = ~/.gitconfig.colors
